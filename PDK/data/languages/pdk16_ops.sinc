	A = 0;
}
:T0SN M_M8_0^"."^n11_9 is b15_12=0b1000 & M_M8_0 & n11_9 & skiptgt {
	local x:1 = M_M8_0;
	local m:1 = (1:1 << n11_9);
	if (!((x & m) == 0)) goto <ns>;
	goto skiptgt;
	<ns>
}
:T1SN M_M8_0^"."^n11_9 is b15_12=0b1001 & M_M8_0 & n11_9 & skiptgt {
	local x:1 = M_M8_0;
	local m:1 = (1:1 << n11_9);
	if (!((x & m) != 0)) goto <ns>;
	goto skiptgt;
	<ns>
}
:SET0 M_M8_0^"."^n11_9 is b15_12=0b1010 & M_M8_0 & n11_9 {
	local x:1 = M_M8_0;
	local m:1 = (1:1 << n11_9);
	M_M8_0 = x & ~m;
}
:SET1 M_M8_0^"."^n11_9 is b15_12=0b1011 & M_M8_0 & n11_9 {
	local x:1 = M_M8_0;
	local m:1 = (1:1 << n11_9);
	M_M8_0 = x | m;
}
:GOTO T_k12_0 is b15_13=0b110 & T_k12_0 {
	goto T_k12_0;
}
:CALL T_k12_0 is b15_13=0b111 & T_k12_0 {
	local spa:2 = zext(sp);
	local ret:2 = inst_next;
	*[ram]:2 spa = ret;
	sp = sp + 2;
	call T_k12_0;
}
